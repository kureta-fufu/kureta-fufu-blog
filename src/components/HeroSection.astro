---
// src/components/HeroSection.astro
// トップページのヒーローセクション：北欧ナチュラルな雰囲気とキャッチコピー
---

<section class="relative overflow-hidden min-h-[90vh] flex items-center bg-base" style="background-image: url('/images/hero-bg-clean.jpeg'); background-size: cover; background-position: center;">
  <!-- 背景オーバーレイ（画像が明るすぎる場合に備えて少し白を重ねる） -->
  <div class="absolute inset-0 bg-white/40 pointer-events-none"></div>

  <!-- 装飾サークル -->
  <div class="absolute top-20 right-10 w-64 h-64 rounded-full bg-light-blue/10 blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-20 left-10 w-48 h-48 rounded-full bg-sage/15 blur-3xl pointer-events-none"></div>

  <!-- メインコンテンツ -->
  <div class="relative z-10 max-w-6xl mx-auto px-4 py-20">
    <div class="grid lg:grid-cols-2 gap-12 items-center">

      <!-- テキストエリア -->
      <div class="animate-fade-in bg-white/60 backdrop-blur-sm p-8 rounded-3xl shadow-soft border border-white/40">
        <!-- バッジ -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-white/80 border border-light-blue/30 rounded-full text-light-blue text-xs font-bold mb-6">
          <span class="w-2 h-2 rounded-full bg-light-blue animate-pulse"></span>
          新婚夫婦のリアルな記録
        </div>

        <!-- メインタイトル -->
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-navy leading-tight mb-6 text-balance">
          AI×個人手配で<br />
          <span class="text-light-blue">叶えるこだわり旅</span><br />
          <span class="text-2xl md:text-3xl font-medium text-warm-gray">Vlog × 暮らし</span>
        </h1>

        <!-- サブコピー -->
        <p class="text-warm-gray text-base md:text-lg leading-relaxed mb-8 max-w-md">
          Geminiプロンプトを駆使した完全個人手配旅行・新婚夫婦のリアルな家計管理・実家の整理まで。旅と暮らしをもっと豊かに。
        </p>

        <!-- CTAボタン -->
        <div class="flex flex-wrap gap-4">
          <a
            href="/category/travel"
            class="affiliate-btn affiliate-btn-shine px-8 py-4 text-sm"
            id="hero-travel-btn"
          >
            ✈️ 旅記事を読む
          </a>
          <a
            href="/category/life"
            class="inline-flex items-center gap-2 px-8 py-4 rounded-full font-bold text-navy text-sm border-2 border-navy hover:bg-navy hover:text-white transition-all duration-300 bg-white/50"
            id="hero-life-btn"
          >
            🏠 暮らし記事へ
          </a>
        </div>

        <!-- 統計バッジ -->
        <div class="flex flex-wrap gap-4 mt-10">
          <div class="flex items-center gap-2 text-sm text-warm-gray">
            <span class="text-2xl">✈️</span>
            <span>個人手配旅行<br /><strong class="text-navy">全記録公開中</strong></span>
          </div>
          <div class="w-px bg-warm-gray/20"></div>
          <div class="flex items-center gap-2 text-sm text-warm-gray">
            <span class="text-2xl">🤖</span>
            <span>Gemini活用<br /><strong class="text-navy">プロンプト全文あり</strong></span>
          </div>
          <div class="w-px bg-warm-gray/20"></div>
          <div class="flex items-center gap-2 text-sm text-warm-gray">
            <span class="text-2xl">📹</span>
            <span>Vlog<br /><strong class="text-navy">YouTube連動</strong></span>
          </div>
        </div>
      </div>

      <!-- イラスト/ビジュアルエリア -->
      <div class="relative animate-slide-up" style="animation-delay: 0.2s;">
        <div class="relative">
          <!-- メインカード（浮遊アニメーション） -->
          <div class="animate-float bg-white/90 backdrop-blur-sm rounded-3xl shadow-card p-6 text-center border border-white">
            <img src="/images/avatar.jpeg" alt="くれた夫婦" class="w-48 h-48 mx-auto rounded-full object-cover shadow-inner mb-4 border-4 border-white" />
            <p class="font-bold text-navy text-lg mb-1">くれた夫婦のAI旅と暮らし</p>
            <p class="text-warm-gray text-sm">Geminiプロンプトで<br />コスパ最強の旅を設計</p>
            <div class="mt-4 flex justify-center gap-2">
              <span class="tag tag-travel">スペイン</span>
              <span class="tag tag-travel">ヴェネチア</span>
              <span class="tag tag-travel">個人手配</span>
            </div>
          </div>

          <!-- 小カード（右上） -->
          <div class="absolute -top-4 -right-4 bg-white/90 backdrop-blur-sm border border-sage/30 rounded-2xl p-4 shadow-soft">
            <p class="text-xs text-sage font-bold">暮らしと家計</p>
            <p class="text-navy font-bold mt-1">🏠 毎月公開中</p>
          </div>

          <!-- 小カード（左下） -->
          <div class="absolute -bottom-4 -left-4 bg-white/90 backdrop-blur-sm border border-light-blue/30 rounded-2xl p-4 shadow-soft">
            <p class="text-xs text-light-blue font-bold">YouTube</p>
            <p class="text-navy font-bold mt-1">📹 Vlog公開</p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- 波形装飾（下部） -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0 40C240 80 480 0 720 40C960 80 1200 0 1440 40V80H0V40Z" fill="white" fill-opacity="0.5"/>
    </svg>
  </div>
</section>
