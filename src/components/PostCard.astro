---
// src/components/PostCard.astro
// 記事一覧用カードコンポーネント

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  heroImage?: string;
  category: 'travel' | 'life' | 'real-estate';
  tags?: string[];
  slug: string;
}

const { title, description, pubDate, heroImage, category, tags = [], slug } = Astro.props;

const categoryMap = {
  travel: { label: 'AI×個人手配旅', class: 'tag-travel', emoji: '✈️' },
  life: { label: '暮らしと家計', class: 'tag-life', emoji: '🏠' },
  'real-estate': { label: '実家整理・不動産', class: 'tag-real-estate', emoji: '🏡' },
};

const catInfo = categoryMap[category];

const formattedDate = pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="post-card group">
  <a href={`/posts/${slug}`} class="block" id={`post-${slug}`}>
    <!-- アイキャッチ画像 -->
    <div class="relative overflow-hidden aspect-video bg-gradient-to-br from-pale-blue to-cream">
      {heroImage ? (
        <img
          src={heroImage}
          alt={title}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-5xl">
          {catInfo.emoji}
        </div>
      )}
      <!-- カテゴリーバッジ（画像上） -->
      <div class="absolute top-3 left-3">
        <span class:list={['tag', catInfo.class, 'shadow-soft']}>{catInfo.label}</span>
      </div>
    </div>

    <!-- テキストコンテンツ -->
    <div class="p-5">
      <!-- 投稿日 -->
      <time
        datetime={pubDate.toISOString()}
        class="text-xs text-warm-gray flex items-center gap-1 mb-2"
      >
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        {formattedDate}
      </time>

      <!-- タイトル -->
      <h3 class="font-bold text-navy text-base leading-snug mb-3 group-hover:text-light-blue transition-colors duration-200 line-clamp-2">
        {title}
      </h3>

      <!-- 概要 -->
      <p class="text-warm-gray text-sm leading-relaxed line-clamp-2 mb-4">
        {description}
      </p>

      <!-- タグ -->
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.slice(0, 3).map((tag) => (
            <span class="inline-block px-2 py-0.5 text-xs bg-cream text-warm-gray rounded-full">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </div>

    <!-- 続きを読む -->
    <div class="px-5 pb-5">
      <span class="text-light-blue text-xs font-bold flex items-center gap-1 group-hover:gap-2 transition-all duration-200">
        続きを読む
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    </div>
  </a>
</article>
