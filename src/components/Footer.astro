---
// src/components/Footer.astro
// フッター：著作権・プライバシーポリシー・SNSリンク
---

<footer class="bg-navy text-white mt-16">
  <!-- 上部：SNSリンク -->
  <div class="max-w-6xl mx-auto px-4 py-10 text-center">
    <p class="text-light-blue font-medium text-sm mb-4 tracking-wider">FOLLOW US</p>
    <div class="flex justify-center gap-4 mb-8">
      <!-- YouTube -->
      <a
        href="https://www.youtube.com/@kureta-kureta"
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 rounded-full bg-white/10 hover:bg-red-500 flex items-center justify-center transition-colors duration-200"
        aria-label="YouTubeチャンネル"
      >
        <svg class="w-5 h-5 fill-white" viewBox="0 0 24 24"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.6 5.8a3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1C24 15.9 24 12 24 12s0-3.9-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg>
      </a>
      <!-- Instagram -->
      <a
        href="https://www.instagram.com/kureta_life"
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 rounded-full bg-white/10 hover:bg-gradient-to-tr hover:from-yellow-400 hover:to-pink-500 flex items-center justify-center transition-colors duration-200"
        aria-label="Instagramアカウント"
      >
        <svg class="w-5 h-5 fill-white" viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 3.3.2 4.8 1.7 5 5 .1 1.3.1 1.6.1 4.8 0 3.2 0 3.6-.1 4.8-.2 3.3-1.7 4.8-5 5-1.3.1-1.6.1-4.9.1-3.2 0-3.6 0-4.8-.1-3.3-.2-4.8-1.7-5-5C2.1 15.6 2 15.3 2 12c0-3.2 0-3.6.1-4.8.2-3.3 1.7-4.8 5-5 1.2-.1 1.6-.1 4.9-.1zM12 0C8.7 0 8.3 0 7.1.1 2.7.3.3 2.7.1 7.1 0 8.3 0 8.7 0 12c0 3.3 0 3.7.1 4.9.2 4.4 2.6 6.8 7 7C8.3 24 8.7 24 12 24c3.3 0 3.7 0 4.9-.1 4.4-.2 6.8-2.6 7-7 .1-1.2.1-1.6.1-4.9 0-3.3 0-3.7-.1-4.9-.2-4.4-2.6-6.8-7-7C15.7 0 15.3 0 12 0zm0 5.8a6.2 6.2 0 1 0 0 12.4A6.2 6.2 0 0 0 12 5.8zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.8a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8z"/></svg>
      </a>
      <!-- X (Twitter) -->
      <a
        href="https://x.com/kureta_kureta_x"
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 rounded-full bg-white/10 hover:bg-black flex items-center justify-center transition-colors duration-200"
        aria-label="X(Twitter)アカウント"
      >
        <svg class="w-5 h-5 fill-white" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
    </div>

    <!-- フッターリンク -->
    <div class="flex flex-wrap justify-center gap-6 text-sm text-white/60 mb-6">
      <a href="/" class="hover:text-white transition-colors duration-200">ホーム</a>
      <a href="/category/travel" class="hover:text-white transition-colors duration-200">AI×個人手配旅</a>
      <a href="/category/life" class="hover:text-white transition-colors duration-200">暮らしと家計</a>
      <a href="/category/real-estate" class="hover:text-white transition-colors duration-200">実家整理・不動産</a>
      <a href="/contact" class="hover:text-white transition-colors duration-200">お問い合わせ</a>
      <a href="/privacy-policy" class="hover:text-white transition-colors duration-200">プライバシーポリシー</a>
    </div>

    <!-- 免責事項 -->
    <p class="text-xs text-white/40 max-w-xl mx-auto leading-relaxed mb-4">
      当サイトは一部アフィリエイトリンクを含みます。収益はサイト運営・コンテンツ制作に使用されます。
    </p>

    <!-- 著作権 -->
    <p class="text-sm text-white/50">
      &copy; {new Date().getFullYear()} くれた夫婦のAI旅と暮らし. All Rights Reserved.
    </p>
  </div>
</footer>
