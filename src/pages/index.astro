---
// src/pages/index.astro
// トップページ

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import CategoryCards from '../components/CategoryCards.astro';
import PostCard from '../components/PostCard.astro';
import SNSSection from '../components/SNSSection.astro';
import { getCollection } from 'astro:content';

// 公開済み記事を日付新しい順で最大6件取得
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const latestPosts = sortedPosts.slice(0, 6);
---

<BaseLayout
  title="くれた夫婦のAI旅と暮らし"
  description="AIプロンプトや個人手配で叶える特別で効率的な旅（Vlog連動）と、20〜30代夫婦のリアルな暮らし・お金管理・新婚生活を発信するブログ。"
>
  <!-- ① ヒーローセクション -->
  <HeroSection />

  <!-- ② 3大カテゴリーカード -->
  <CategoryCards />

  <!-- ③ 最新記事一覧 -->
  <section class="py-20 bg-cream/50">
    <div class="max-w-6xl mx-auto px-4">
      <!-- セクションタイトル -->
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-light-blue font-bold text-xs tracking-[0.3em] uppercase mb-3">LATEST POSTS</p>
          <h2 class="text-3xl md:text-4xl font-bold text-navy">最新の記事</h2>
        </div>
        <a
          href="/posts"
          class="hidden md:flex items-center gap-2 text-light-blue text-sm font-bold hover:gap-3 transition-all duration-200"
        >
          すべて見る
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- 記事カードグリッド -->
      {latestPosts.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {latestPosts.map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              heroImage={post.data.heroImage}
              category={post.data.category}
              tags={post.data.tags}
              slug={post.slug}
            />
          ))}
        </div>
      ) : (
        <!-- 記事がない場合のプレースホルダー -->
        <div class="text-center py-16 text-warm-gray">
          <p class="text-4xl mb-4">📝</p>
          <p class="font-medium">記事を準備中です。もうしばらくお待ちください！</p>
        </div>
      )}

      <!-- モバイル用「すべて見る」ボタン -->
      <div class="mt-10 text-center md:hidden">
        <a
          href="/posts"
          class="inline-flex items-center gap-2 px-8 py-3 rounded-full border-2 border-light-blue text-light-blue font-bold text-sm hover:bg-light-blue hover:text-white transition-all duration-200"
        >
          すべての記事を見る →
        </a>
      </div>
    </div>
  </section>

  <!-- ④ プロフィールバナー -->
  <section class="py-16 bg-base">
    <div class="max-w-6xl mx-auto px-4">
      <div class="bg-gradient-to-br from-pale-blue to-sage/20 rounded-3xl p-8 md:p-12 flex flex-col md:flex-row items-center gap-8 border border-light-blue/20">
        <!-- アバター -->
        <img src="/images/avatar.jpeg" alt="くれた夫婦" class="w-32 h-32 rounded-full object-cover shadow-card flex-shrink-0 border-4 border-white" />

        <!-- テキスト -->
        <div class="text-center md:text-left flex-1">
          <p class="text-light-blue font-bold text-xs tracking-[0.3em] uppercase mb-2">ABOUT US</p>
          <h2 class="text-2xl font-bold text-navy mb-3">くれた夫婦について</h2>
          <p class="text-warm-gray text-sm leading-relaxed mb-6 max-w-lg">
            20代後半の新婚夫婦です 🐨<br />
            AI（Gemini）を使ったスマートな旅行計画や、<br class="hidden md:inline" />
            家計管理・実家整理の記録を、プロンプトや実体験を交えて<br class="hidden md:inline" />
            リアルにお届けします！<br />
            ヨーロッパ個人手配旅行の YouTube Vlog も発信中 🎬
          </p>
          <a
            href="/about"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-navy text-white font-bold text-sm hover:bg-light-blue transition-colors duration-200"
          >
            詳しいプロフィール →
          </a>
        </div>

        <!-- 右側ミニカード -->
        <div class="flex flex-col sm:flex-row gap-4 md:gap-6 items-stretch">
          <!-- 夫カード -->
          <a href="/about" class="bg-white/80 backdrop-blur-sm p-4 rounded-3xl shadow-soft border border-white/40 text-center w-48 hover:shadow-card hover:-translate-y-1 transition-all duration-200 flex flex-col items-center">
            <img src="/images/husband-smile.png" alt="夫" class="w-16 h-auto mx-auto mb-2" />
            <p class="font-bold text-navy mb-1">夫</p>
            <p class="text-xs text-warm-gray leading-snug">AI・旅行計画オタク<br />個人手配の旅を極めたい</p>
          </a>
          <!-- 妻カード -->
          <a href="/about" class="bg-white/80 backdrop-blur-sm p-4 rounded-3xl shadow-soft border border-white/40 text-center w-48 hover:shadow-card hover:-translate-y-1 transition-all duration-200 flex flex-col items-center">
            <img src="/images/wife-smile.png" alt="妻" class="w-16 h-auto mx-auto mb-2" />
            <p class="font-bold text-navy mb-1">妻</p>
            <p class="text-xs text-warm-gray leading-snug">Vlog・思い出づくりが好き<br />北欧インテリア好き</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ⑤ SNS連携セクション -->
  <SNSSection />
</BaseLayout>
